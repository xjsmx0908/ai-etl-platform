# ==========================================
# Parser 切块配置
# ==========================================

# 宿主键一律带 PARSER_ 前缀，compose 负责把它重命名成容器内的变量名：
#   PARSER_MIN_CHUNK_SIZE -> parser 容器的 MIN_CHUNK_SIZE
#   PARSER_MAX_CHUNK_SIZE -> parser 容器的 MAX_CHUNK_SIZE，同一个值也喂给 etl-worker
#   PARSER_CHUNK_OVERLAP  -> parser 容器的 CHUNK_OVERLAP，同一个值也喂给 etl-worker
# 之所以改名：同一个宿主值要发给两个服务，而 etl-worker 侧的键本来就带前缀。
# 直接写 MIN_CHUNK_SIZE / MAX_CHUNK_SIZE / CHUNK_OVERLAP 是死键 —— compose 会用
# 自己的值覆盖容器里这三个变量，.env 里的值被静默忽略。
# scripts/tests/test_env_example_contract.py 钉住这条重命名契约。
PARSER_MIN_CHUNK_SIZE=128
PARSER_MAX_CHUNK_SIZE=600
PARSER_CHUNK_OVERLAP=50

# ==========================================
# 扩缩容配置
# ==========================================

WORKER_REPLICAS=2
API_REPLICAS=1

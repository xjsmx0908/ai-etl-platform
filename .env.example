# AI-ETL Platform 环境变量配置

# ==========================================
# 基础配置
# ==========================================

# 运行环境: dev | staging | production
ENVIRONMENT=dev

# ==========================================
# Kafka 配置
# ==========================================

KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=doc-processing
KAFKA_GROUP_ID=etl-pipeline-dev
KAFKA_DLQ_TOPIC=doc-processing-dlq

# ==========================================
# Redis 配置
# ==========================================

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# Qdrant 向量数据库
# ==========================================

STORE_ENDPOINT=http://qdrant:6333
STORE_COLLECTION=documents
STORE_API_KEY=

# ==========================================
# Embedding 配置
# ==========================================

# OpenAI 格式 API（兼容 Ollama）
EMBED_ENDPOINT=http://host.docker.internal:11434/api/embeddings
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
EMBED_RATE_LIMIT=50

# ==========================================
# LLM 配置
# ==========================================

LLM_ENDPOINT=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# ==========================================
# MinIO 对象存储
# ==========================================

S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_USE_SSL=false

# ==========================================
# JWT 鉴权
# ==========================================

JWT_SECRET=your-jwt-secret-change-in-production

# ==========================================
# Worker 配置
# ==========================================

PIPELINE_MAX_WORKERS=10
PIPELINE_STAGE_TIMEOUT=30s
PIPELINE_TIMEOUT=5m
PIPELINE_MAX_RETRIES=3
PIPELINE_BATCH_SIZE=10

# ==========================================
# Parser 切块配置
# ==========================================

MIN_CHUNK_SIZE=128
MAX_CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# ==========================================
# 扩缩容配置
# ==========================================

WORKER_REPLICAS=2
API_REPLICAS=1

# AI-ETL Platform 环境变量配置

# ==========================================
# 基础配置
# ==========================================

# 运行环境: dev | staging | production。production 对平台 token 启用身份
# fail-closed：拒绝 test/legacy 方法和未知内部主体；非生产保留评测兼容。
ENVIRONMENT=dev

# 默认把 Compose 主机端口绑到回环。局域网直连用 docker-compose.lab.yml，
# 紧急调试才设 COMPOSE_BIND=0.0.0.0。生产公网只走 Nginx 80/443。
COMPOSE_BIND=127.0.0.1
WEB_HOST_PORT=3100
QUERY_API_HOST_PORT=8080

# Query API /metrics 与 /version 的 Bearer token（非 dev 必填）。
METRICS_TOKEN=
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_USER=5
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_DURATION=15m
# 设为 0 可关闭登录限流；production 启动校验会拒绝。
# LOGIN_RATE_LIMIT=0
QUERY_MAX_CONCURRENCY=4
UPLOAD_MAX_CONCURRENCY=2
AGENT_MAX_CONCURRENCY=2
QUESTION_MAX_RUNES=2000
QUERY_MAX_BODY_KB=64
JSON_MAX_BODY_KB=16

# ==========================================
# API 网关安全（CORS + HTTP 超时）
# ==========================================

# 逗号分隔；生产环境不可使用 *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_HANDLER_TIMEOUT=60s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_HEADER_BYTES=1048576
IDEMPOTENCY_TTL=24h
TASK_STATUS_STORE=auto
TASK_STATUS_TTL=168h

# ==========================================
# Kafka 配置
# ==========================================

KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=doc-processing
KAFKA_GROUP_ID=etl-pipeline-dev
KAFKA_DLQ_TOPIC=doc-processing-dlq
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_POLL_INTERVAL=500ms
OUTBOX_RELAY_LEASE=30s
# Governance approval notifications. Empty URL skips external delivery but still
# records durable outbox events. Token falls back to ALERT_WEBHOOK_TOKEN.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_WEBHOOK_TIMEOUT=5s
# Optional service token for POST /v1/release-center/workflow/decision.
# Empty disables the inbound adapter; engines can still use admin JWT Decide.
WORKFLOW_CALLBACK_TOKEN=
INGESTION_JOB_LEASE=18h
INGESTION_METRICS_INTERVAL=15s
ORPHAN_CLEANUP_INTERVAL=15m
ORPHAN_CLEANUP_GRACE_PERIOD=24h
ORPHAN_CLEANUP_BATCH_SIZE=100

# ==========================================
# Redis 配置
# ==========================================

# 两个实例职责分离：
#   redis-cache 只放可淘汰的语义检索缓存（allkeys-lru）
#   redis-state 放 Agent run、审批审计、fencing token、幂等键、checkpoint、
#               任务状态、ES 重试队列（noeviction + AOF）
# 淘汰 state 里的数据是正确性问题而非容量问题：丢掉 fencing token 会让
# agent.Orchestrator 的陈旧写入拒绝失效，丢掉审批记录会销毁合规凭证。
REDIS_CACHE_ADDR=redis-cache:6379
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DB=0

REDIS_STATE_ADDR=redis-state:6379
REDIS_STATE_PASSWORD=
REDIS_STATE_DB=0

# 兼容旧配置：未设置上面两组时，REDIS_* 作为共享回退值。
# 生产环境禁止让 state 与 cache 指向同一实例（启动校验会拒绝）。
REDIS_ADDR=redis-cache:6379
REDIS_PASSWORD=
# Compose 默认从 secrets/examples/redis_password 读取；生产禁止空口令。
REDIS_DB=0

# ==========================================
# Qdrant 向量数据库
# ==========================================

STORE_ENDPOINT=http://qdrant:6333
STORE_COLLECTION=documents
STORE_API_KEY=
# 非 dev 必填。Compose 默认从 secrets/examples/store_api_key 注入 Qdrant。

# ==========================================
# Elasticsearch 全文索引（最终一致性）
# ==========================================

ES_ADDRESS=http://elasticsearch:9200
ES_API_KEY=
ES_INDEX=documents_text
ES_DISK_WATERMARK_LOW=8gb
ES_DISK_WATERMARK_HIGH=6gb
ES_DISK_WATERMARK_FLOOD_STAGE=4gb
ES_QUEUE_KEY=es:index:retry
ES_DEADLETTER_KEY=es:index:deadletter
ES_REPLAY_PERIOD=2s
ES_MAX_RETRIES=12
ES_RETRY_BASE_BACKOFF=2s
ES_RETRY_MAX_BACKOFF=5m
ES_RETRY_JITTER=0.2

# ==========================================
# Embedding 配置
# ==========================================

# OpenAI 格式 API（兼容 Ollama）
EMBED_ENDPOINT=http://host.docker.internal:11434/api/embeddings
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
EMBED_RATE_LIMIT=50
EMBED_CONCURRENCY=1
# CPU 本地 embedding 单请求超时(并发时会排队;GPU 可放宽)
EMBED_TIMEOUT=180s
# Pin local Ollama embedding so idle periods do not pay a ~2s cold load.
EMBED_KEEP_ALIVE=24h

# ==========================================
# Retrieval Gateway（模块二：多路召回 + 重排 + 缓存）
# ==========================================

# Scatter-Gather 召回总超时
RETRIEVAL_TIMEOUT=300ms
# 每路粗召回候选数量
RETRIEVAL_CANDIDATE_K=50
# 默认最终上下文数量（请求 top_k 未传时使用）
RETRIEVAL_FINAL_TOP_K=5
# 是否启用 Elasticsearch 全文召回
RETRIEVAL_ENABLE_ES=true
# 是否启用 HTTP Cross-Encoder Reranker
RETRIEVAL_ENABLE_RERANK=false
# 仅隔离评测开启：允许请求返回必要来源的聚合阶段覆盖计数，不返回来源 ID
RETRIEVAL_DIAGNOSTICS_ENABLED=false
# Rerank 策略：auto 跳过明确精确路由；语义/混合查询有 exact 候选证据时 rerank 后 pin exact match；always 用于离线实验复现裸 rerank
RETRIEVAL_RERANK_POLICY=auto
# 可参与 exact evidence 的业务 metadata 字段；上传时用 multipart 字段 metadata='{"contract_no":"..."}'
RETRIEVAL_EXACT_SCHEMA_FIELDS=doc_id,chunk_id,order_id,order_no,contract_id,contract_no,ticket_id,invoice_no,trace_id,request_id,customer_ref,email,phone,sku,user_id
# 生成后忠实度验证：答案的关键断言（事实/数字/结论）无法从检索来源溯源时，替换为固定拒答句。
# 低分辨率 embedding 下分数阈值无法区分"弱相关命中"与"无依据编造"（bge-m3 正负例同分 0.5），故在模糊相关带调用校验器判定。
RETRIEVAL_GROUNDING_CHECK=true
# 模糊相关带下限/上限：max_relevance 落在该区间内的查询才触发校验器调用（低于下限由 RETRIEVAL_MIN_RELEVANCE 兜底，高于上限直接信任）
RETRIEVAL_GROUNDING_LOW_BOUND=0.45
RETRIEVAL_GROUNDING_HIGH_BOUND=0.70
RERANK_ENDPOINT=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-base
# Optional local reranker-service profile settings
RERANKER_BACKEND=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_MAX_DOCUMENTS=100
RERANKER_MAX_DOCUMENT_CHARS=12000
RERANKER_LOAD_ON_STARTUP=true
# Redis 语义缓存；缓存范围包含 tenant + permission scope，避免越权命中
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL=10m
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=128

# ==========================================
# LLM 配置
# ==========================================

LLM_ENDPOINT=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# LLM 成本估算（每 1K token 的 USD 价格）。未配置时成本指标保持 0。
# 填入供应商单价后，Prometheus 会记录 ai_etl_llm_tokens_total 与 ai_etl_llm_cost_usd_total。
# LLM_PRICE_PROMPT_PER_1K=
# LLM_PRICE_COMPLETION_PER_1K=

# 系统 prompt 版本（从 prompts/rag_answer/{version}.md 加载，git 跟踪便于 A/B）
# PROMPT_VERSION=v1

# ==========================================
# Observability alerts (Module 4)
# ==========================================

ALERT_DELIVERY_TIMEOUT_SECONDS=5
ALERT_WEBHOOK_LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3001

# Host ports (optional). Keep defaults for local development. The eval runner
# uses docker-compose.eval.yml to keep internal services off the host and maps
# only Query API to a Docker-assigned port.
# KAFKA_HOST_PORT=9092
# REDIS_HOST_PORT=6379
# QDRANT_HTTP_HOST_PORT=6333
# QDRANT_GRPC_HOST_PORT=6334
# ELASTICSEARCH_HOST_PORT=9200
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# JAEGER_UI_HOST_PORT=16686
# JAEGER_OTLP_GRPC_HOST_PORT=4317
# JAEGER_OTLP_HTTP_HOST_PORT=4318
# PROMETHEUS_HOST_PORT=9090
# ALERTMANAGER_HOST_PORT=9093
# KAFKA_UI_HOST_PORT=8090
# PARSER_HOST_PORT=8000
# QUERY_API_HOST_PORT=8080
# RERANKER_HOST_PORT=8091

# ==========================================
# Agent Orchestrator（模块三：状态机 + Planner + 工具）
# ==========================================

AGENT_NODE_ID=agent-api-1
AGENT_MAX_STEPS=8
AGENT_REVIEW_MAX_TOKEN_BUDGET=32000
AGENT_LOCK_TTL=30s
AGENT_RUN_TTL=24h
AGENT_RUN_TIMEOUT=30m
AGENT_APPROVAL_TIMEOUT=15m
# auto: dev 使用 rule，非 dev 使用 llm；production 禁止 rule
AGENT_PLANNER_TYPE=auto
AGENT_PLANNER_ENDPOINT=http://host.docker.internal:11434/v1
AGENT_PLANNER_API_KEY=
AGENT_PLANNER_MODEL=qwen2.5:7b
AGENT_PLANNER_TIMEOUT=30s
AGENT_PLANNER_MAX_TOKENS=512
# 预审报告有效期与过期后清理；0 表示不设置过期/不清理。
RELEASE_REVIEW_TTL=168h
RELEASE_REVIEW_RETENTION=2160h
# ==========================================
# MinIO 对象存储
# ==========================================

# MinIO 账号只从 secrets 文件读取，不要再使用 minioadmin 默认值。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documents
S3_USE_SSL=false

# ==========================================
# JWT 鉴权
# ==========================================

# 生产环境必须替换为 >= 32 位强随机字符串
JWT_SECRET=
# Web 前端会话 cookie 的 Secure 标志：仅当前端走 HTTPS 时设为 true；HTTP 部署必须保持
# false，否则浏览器丢弃 Secure cookie，所有请求 401 跳回登录页
COOKIE_SECURE=false
# 生产 HTTPS 必须改为 true。

# 企业 OIDC（默认关闭）。首个验收目标为标准 Keycloak realm；issuer 必须是 HTTPS，
# redirect URI 必须与 IdP 客户端登记值完全一致。生产启用后普通密码登录自动关闭。
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_LOGOUT_REDIRECT_URI=
OIDC_TRANSACTION_TTL=5m

# SCIM 2.0 用户生命周期（默认关闭）。每个连接器固定绑定一个内部租户和 issuer；
# 当前仅允许 externalId 作为显式 OIDC subject，默认角色建议 readonly。
SCIM_ENABLED=false
SCIM_CONNECTOR_ID=
SCIM_TENANT_ID=
SCIM_ISSUER=
SCIM_SUBJECT_ATTRIBUTE=externalId
SCIM_DEFAULT_ROLE=readonly
SCIM_MAX_BODY_KB=64

# 个人演示平台会话默认关闭，且只允许 personal-demo-v1 在 ENVIRONMENT=dev 下启用。
# 启用后 password/OIDC 登录签发 ps1_，Cookie 最长 30 分钟；OIDC 还要求 demo-mfa 证据。
SESSION_CORE_ENABLED=false
# personal-demo-v1 允许 1-3；默认及批准基线为 3。
SESSION_MAX_ACTIVE_SESSIONS=3
IDENTITY_POLICY_PROFILE=

# ==========================================
# PostgreSQL（用户/租户/文档注册表）
# ==========================================

# 完整 DSN；生产必须通过 PG_DSN_FILE 指向 secret 文件（见下方 secrets 段）
PG_DSN=
PG_HOST_PORT=5432
PG_USER=app
PG_DB=ai_etl

# 首启 bootstrap：数据库为空时创建初始管理员（生产强制强密码 >= 12 位）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TENANT=default

# 启动时从 Qdrant 回填文档注册表（历史数据一次性迁移，默认关）
RECONCILE_DOCS_ON_STARTUP=false

# Active-generation reconciliation (worker). Divergence reopens the durable
# ingestion outbox for an idempotent rebuild; repeated repairs are bounded.
INDEX_RECONCILE_ENABLED=true
INDEX_RECONCILE_INTERVAL=5m
INDEX_RECONCILE_LEASE=30m
INDEX_RECONCILE_BATCH_SIZE=20
INDEX_RECONCILE_MAX_REPAIRS=3

# Retired generation cleanup stays disabled until an approved rollback window
# is configured. Go duration syntax does not support days: 720h = 30 days.
INDEX_RETENTION_ENABLED=false
INDEX_RETENTION_WINDOW=0s
INDEX_RETENTION_INTERVAL=1h
INDEX_RETENTION_LEASE=30m
INDEX_RETENTION_BATCH_SIZE=20

# Restart-safe document deletion collector. This is independent of generation
# retention and remains active even when INDEX_RETENTION_ENABLED=false.
DELETION_INTERVAL=1m
DELETION_LEASE=30m
DELETION_BATCH_SIZE=20
DELETION_RETRY_BACKOFF=5m

# ==========================================
# 上传限制（Query API）
# ==========================================

# 上传请求整体上限（MB）
MAX_UPLOAD_SIZE_MB=100
MAX_OCR_PAGES=0
# multipart 解析内存缓冲上限（MB，超出部分自动落盘临时文件）
MULTIPART_MAX_MEMORY_MB=4

# ==========================================
# Worker 配置
# ==========================================

PIPELINE_MAX_WORKERS=10
PIPELINE_STAGE_TIMEOUT=180s
PIPELINE_TIMEOUT=4h
PIPELINE_MAX_RETRIES=1
PIPELINE_BATCH_SIZE=10
OCR_PAGE_BATCH_SIZE=25
OCR_KAFKA_TOPIC=doc-processing-ocr
OCR_KAFKA_DLQ_TOPIC=doc-processing-ocr-dlq

# Parser Service 内部鉴权（生产必须替换）
PARSER_INTERNAL_TOKEN=

# ==========================================
# Docker Secrets 源文件（可选覆盖）
# ==========================================

# 这些变量用于覆盖 docker-compose.yml 顶层 secrets 的默认占位路径。
# 如果不设置，将默认读取 ./secrets/examples/* 占位文件。
# 建议本地创建 secrets/dev/* 并在 .env 中指向该目录（该目录默认已被 gitignore）。
# JWT_SECRET_FILE_PATH=./secrets/dev/jwt_secret
# OIDC_CLIENT_SECRET_FILE_PATH=./secrets/dev/oidc_client_secret
# SCIM_BEARER_TOKENS_FILE_PATH=./secrets/dev/scim_bearer_tokens
# PARSER_INTERNAL_TOKEN_FILE_PATH=./secrets/dev/parser_internal_token
# S3_ACCESS_KEY_FILE_PATH=./secrets/dev/s3_access_key
# S3_SECRET_KEY_FILE_PATH=./secrets/dev/s3_secret_key
# EMBED_API_KEY_FILE_PATH=./secrets/dev/embed_api_key
# LLM_API_KEY_FILE_PATH=./secrets/dev/llm_api_key
# STORE_API_KEY_FILE_PATH=./secrets/dev/store_api_key
# ES_API_KEY_FILE_PATH=./secrets/dev/es_api_key
# REDIS_PASSWORD_FILE_PATH=./secrets/dev/redis_password
# METRICS_TOKEN_FILE_PATH=./secrets/dev/metrics_token
# PG_PASSWORD_FILE_PATH=./secrets/dev/pg_password
# PG_DSN_FILE_PATH=./secrets/dev/pg_dsn
# ALERT_WEBHOOK_TOKEN_FILE_PATH=./secrets/dev/alert_webhook_token
# WECOM_WEBHOOK_URL_FILE_PATH=./secrets/dev/wecom_webhook_url
# WORKFLOW_ENGINE_WEBHOOK_URL=http://workflow-engine.example/start
# WORKFLOW_ENGINE_WEBHOOK_TOKEN=

# DINGTALK_WEBHOOK_URL_FILE_PATH=./secrets/dev/dingtalk_webhook_url
# DINGTALK_SECRET_FILE_PATH=./secrets/dev/dingtalk_secret
# GRAFANA_ADMIN_PASSWORD_FILE_PATH=./secrets/dev/grafana_admin_password

# ==========================================
# Parser 切块配置
# ==========================================

MIN_CHUNK_SIZE=128
MAX_CHUNK_SIZE=600
CHUNK_OVERLAP=50
PARSER_MAX_CHUNK_SIZE=600
PARSER_CHUNK_OVERLAP=50

# ==========================================
# 扩缩容配置
# ==========================================

WORKER_REPLICAS=2
API_REPLICAS=1

# ============================================================
# AI ETL Pipeline - 环境变量模板
# 复制为 .env 并填入实际值: cp .env.example .env
# ============================================================

# --- 运行环境 ---
ENVIRONMENT=dev            # dev | staging | production
SESSION_CORE_ENABLED=false # 仅 personal-demo-v1 + dev；启用后登录签发 ps1_
SESSION_MAX_ACTIVE_SESSIONS=3 # personal-demo-v1 允许 1-3
IDENTITY_POLICY_PROFILE=

# --- Pipeline ---
PIPELINE_MAX_WORKERS=10    # Worker 并发数
PIPELINE_TASK_BUFFER=100   # 任务缓冲队列大小
PIPELINE_STAGE_TIMEOUT=30s # 单阶段超时
PIPELINE_TIMEOUT=5m        # 单任务总超时
PIPELINE_MAX_RETRIES=3     # 最大重试次数
PIPELINE_RETRY_BACKOFF=500ms # 重试退避基础间隔
PIPELINE_BATCH_SIZE=10     # 批处理大小

# --- Parser ---
PARSER_MAX_CHUNK_SIZE=4096 # 最大 Chunk 字符数
PARSER_CHUNK_OVERLAP=200   # Chunk 重叠字符数
PARSER_READ_BUFFER=65536   # 读取缓冲区大小

# --- Embedding API ---
EMBED_ENDPOINT=https://api.openai.com/v1/embeddings
EMBED_API_KEY=sk-your-api-key-here
EMBED_MODEL=text-embedding-ada-002
EMBED_DIMENSION=1536
EMBED_MAX_RETRIES=5
EMBED_BACKOFF=500ms
EMBED_MAX_BACKOFF=30s
EMBED_RATE_LIMIT=50        # 请求/秒

# --- 向量数据库 (Qdrant) ---
STORE_ENDPOINT=http://localhost:6333
STORE_API_KEY=             # Qdrant Cloud 需要
STORE_COLLECTION=documents

# --- Sparse Vector (BM25 Hybrid Search) ---
SPARSE_K1=1.2              # BM25 k1 参数
SPARSE_B=0.75              # BM25 b 参数
SPARSE_AVG_DL=256          # 平均文档长度（tokens）

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=doc-processing
KAFKA_GROUP_ID=etl-pipeline
KAFKA_DLQ_TOPIC=doc-processing-dlq
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_POLL_INTERVAL=500ms
OUTBOX_RELAY_LEASE=30s
INGESTION_JOB_LEASE=18h
INGESTION_METRICS_INTERVAL=15s
ORPHAN_CLEANUP_INTERVAL=15m
ORPHAN_CLEANUP_GRACE_PERIOD=24h
ORPHAN_CLEANUP_BATCH_SIZE=100

# --- Redis (Checkpoint) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- 健康检查 & 网关 ---
HEALTH_PORT=8080
UPLOAD_DIR=/data/uploads         # 文件上传存储目录
MAX_UPLOAD_SIZE_MB=512           # 最大上传文件大小(MB)
TASK_STATUS_STORE=auto           # auto | memory | redis
TASK_STATUS_TTL=168h             # 上传/处理任务状态保留时间

# --- LLM Chat (Query Service / RAG 生成) ---
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# --- Agent Orchestrator Planner ---
AGENT_NODE_ID=agent-api-1
AGENT_MAX_STEPS=8
AGENT_LOCK_TTL=30s
AGENT_RUN_TTL=24h
AGENT_PLANNER_TYPE=auto      # auto | llm | rule
AGENT_PLANNER_ENDPOINT=https://api.openai.com/v1/chat/completions
AGENT_PLANNER_API_KEY=sk-your-api-key-here
AGENT_PLANNER_MODEL=gpt-4o-mini
AGENT_PLANNER_TIMEOUT=30s
AGENT_PLANNER_MAX_TOKENS=512

# --- 企业 OIDC（可选）---
# 必须为与登录 callback 同源的 HTTPS URL；留空时退出只撤销本地会话。
OIDC_LOGOUT_REDIRECT_URI=

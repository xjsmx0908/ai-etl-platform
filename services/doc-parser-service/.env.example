# Parser Service Configuration
HOST=0.0.0.0
PORT=8000

# Chunking settings
# 这些是「直接跑本服务」（不经 compose）时的默认值，必须与 app/config.py 的
# 字段默认值一致。
# 经 docker compose 启动时不要在这里改：compose 会用宿主 .env 里的
# PARSER_MIN_CHUNK_SIZE / PARSER_MAX_CHUNK_SIZE / PARSER_CHUNK_OVERLAP
# 覆盖同名容器变量，本文件的这三行不参与。
MIN_CHUNK_SIZE=128
MAX_CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# File upload limits
MAX_FILE_SIZE_MB=100

# Logging
LOG_LEVEL=INFO

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=*

# Internal service-to-service auth
# Priority: INTERNAL_API_TOKEN > INTERNAL_API_TOKEN_FILE
INTERNAL_API_TOKEN=
INTERNAL_API_TOKEN_FILE=

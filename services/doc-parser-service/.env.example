# Parser Service Configuration
HOST=0.0.0.0
PORT=8000

# Chunking settings
MIN_CHUNK_SIZE=128
MAX_CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# File upload limits
MAX_FILE_SIZE_MB=100

# Logging
LOG_LEVEL=INFO

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=*

# Internal service-to-service auth
# Priority: INTERNAL_API_TOKEN > INTERNAL_API_TOKEN_FILE
INTERNAL_API_TOKEN=
INTERNAL_API_TOKEN_FILE=
